{
  "name": "omarchy-repo-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Omarchy pool: index API, releases and dashboard (Cloudflare Workers + D1 + R2)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply omarchy-repo --local",
    "db:migrate:remote": "wrangler d1 migrations apply omarchy-repo --remote",
    "schema:sync": "cargo run -q -p pkg-extract -- schema > src/manifest.schema.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "acorn": "^8.18.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "miniflare": "5.20260911.0-alpha",
    "workerd": "1.20260911.1"
  },
  "dependencies": {
    "openpgp": "^6.3.1",
    "smol-toml": "^1.8.0"
  }
}
