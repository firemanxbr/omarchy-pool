{
  "name": "v* tags: created by GitHub Actions only",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 15368,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "creation"
    }
  ]
}
