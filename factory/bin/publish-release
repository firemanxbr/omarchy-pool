#!/usr/bin/env bash
# publish-release vX.Y.Z <sums>: release.yml's last step before the deploy (#311).
# The release was created as a draft; this publishes it, which is when it
# becomes immutable (immutable releases are on), and only once every asset a
# host or the worker image needs is on it: the binaries, the three agent
# binaries, the signed host bundle and its Sigstore bundle, install.sh, and
# build-images.json (the task build images by digest, #312).
# A release missing one stays a draft, and the pool stays on the previous
# release (deploy needs this job). Run again on a published release with
# every asset, it changes nothing. want=() must name what release.yml's
# publish and host-bundle-upload jobs upload: tests/release-workflow.sh
# checks that every asset host-bundle-upload uploads is here.
#
# Names are not enough: until it is published, any token that may write
# contents can replace a draft's asset. <sums> is the SHA-256 of every file
# the run itself made (`sha256sum` lines, release.yml's host-bundle-upload
# hands them over); each asset is downloaded from the draft and must match,
# or the release stays a draft.
#
# The maintainers' co-signature (#330, design v2 D1 b): no run makes it. A
# maintainer signs the draft's host bundle offline with their security key
# and uploads omarchy-host-vX.Y.Z.tar.gz.<login>.sshsig to the draft
# (`factory/bin/co-sign release vX.Y.Z`, the runbook's *Co-signing a
# release*). The release is published only once the co-signatures meet the
# threshold factory/MAINTAINERS.toml sets here (the one this release's agent
# pins), the one it set at the latest published release, however old (the
# agent most hosts run, which takes the new bundle first: a pause in releases
# never lets a rotated key past it), and the one it set at every release of
# the last 30 days (those releases' agents verify the new bundle before they
# update themselves, as verify-with-agents runs them): `factory/bin/co-sign
# check`, with ssh-keygen. Until then it stays a draft; once they are on it,
# re-running the failed job publishes it. With no threshold anywhere, nothing
# is asked.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
v="${1:?usage: publish-release vX.Y.Z <sums>}"
sums="${2:?usage: publish-release vX.Y.Z <sums>}"
[[ "$v" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "publish-release: $v is not vX.Y.Z" >&2; exit 2; }
want=(
  "omarchy-pool-$v-x86_64-linux.tar.gz" "omarchy-pool-$v-x86_64-linux.tar.gz.sha256"
  "omarchy-pool-$v-aarch64-linux.tar.gz" "omarchy-pool-$v-aarch64-linux.tar.gz.sha256"
  omarchy-staging.pub.asc
  omarchy-agent-x86_64-linux-musl omarchy-agent-aarch64-linux-musl omarchy-agent-aarch64-darwin
  "omarchy-host-$v.tar.gz" "omarchy-host-$v.tar.gz.sigstore.json" install.sh
  build-images.json
)
state="$(gh release view "$v" --json isDraft --jq .isDraft)"
have="$(gh release view "$v" --json assets --jq '.assets[].name')"
missing=()
for a in "${want[@]}"; do grep -qxF -- "$a" <<<"$have" || missing+=("$a"); done
if (( ${#missing[@]} )); then
  if [[ "$state" == true ]]; then echo "publish-release: $v lacks ${missing[*]}; it stays a draft" >&2
  else echo "publish-release: $v is published without ${missing[*]}: a person must look" >&2; fi
  exit 1
fi
sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
patterns=(); for a in "${want[@]}"; do patterns+=(--pattern "$a"); done
gh release download "$v" --dir "$work" "${patterns[@]}" >/dev/null || { echo "publish-release: cannot download $v's assets" >&2; exit 1; }
changed=()
for a in "${want[@]}"; do
  expected="$(awk -v n="$a" '$2 == n || $2 == "*" n { print $1 }' "$sums")"
  [[ -n "$expected" && -f "$work/$a" && "$(sha256 "$work/$a")" == "$expected" ]] || changed+=("$a")
done
if (( ${#changed[@]} )); then
  if [[ "$state" == true ]]; then echo "publish-release: $v's ${changed[*]} are not the bytes this run made; it stays a draft" >&2
  else echo "publish-release: $v is published with ${changed[*]} not the bytes this run made: a person must look" >&2; fi
  exit 1
fi
# The maintainers' co-signature: every one on the draft, then the policy of this
# release, of the latest published one whatever its age, and of every release of
# the last 30 days.
bundle="omarchy-host-$v.tar.gz"
cosigned=(); while IFS= read -r a; do [[ "$a" == "$bundle".*.sshsig ]] && cosigned+=("$a"); done <<<"$have"
mkdir -p "$work/cosignatures"
if (( ${#cosigned[@]} )); then
  patterns=(); for a in "${cosigned[@]}"; do patterns+=(--pattern "$a"); done
  gh release download "$v" --dir "$work/cosignatures" "${patterns[@]}" >/dev/null || { echo "publish-release: cannot download $v's co-signatures" >&2; exit 1; }
fi
policies=(--policy "$v=$root/factory/MAINTAINERS.toml")
cutoff="$(python3 -c "import datetime as d; print((d.datetime.now(d.timezone.utc) - d.timedelta(days=30)).strftime('%Y-%m-%dT%H:%M:%SZ'))")"
tags="$(gh release list --exclude-drafts --limit 200 --json tagName,publishedAt \
  --jq "sort_by(.publishedAt) | reverse | (.[0:1] + map(select(.publishedAt >= \"$cutoff\"))) | unique_by(.tagName) | .[].tagName")" \
  || { echo "publish-release: cannot list the latest release and those of the last 30 days, whose agents must take $v; it stays as it is" >&2; exit 1; }
for tag in $tags; do
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
  if gh api "repos/{owner}/{repo}/contents/factory/MAINTAINERS.toml?ref=$tag" -H "Accept: application/vnd.github.raw" > "$work/maintainers-$tag.toml" 2>"$work/err"; then
    policies+=(--policy "$tag=$work/maintainers-$tag.toml")
  elif ! grep -q 'HTTP 404' "$work/err"; then
    echo "publish-release: cannot read $tag's factory/MAINTAINERS.toml: $(cat "$work/err")" >&2; exit 1
  fi
done
if ! python3 "$root/factory/bin/co-sign" check "$work/$bundle" --namespace host-bundle@omarchy-pool.org \
    --signatures "$work/cosignatures" "${policies[@]}" > "$work/cosign" 2>&1; then
  cat "$work/cosign" >&2
  if [[ "$state" == true ]]; then echo "publish-release: $v lacks the maintainers' co-signature its agents require; it stays a draft (factory/bin/co-sign release $v, then re-run this job)" >&2
  else echo "publish-release: $v is published without the maintainers' co-signature its agents require: a person must look" >&2; fi
  exit 1
fi
cat "$work/cosign"
if [[ "$state" != true ]]; then
  echo "publish-release: $v is already published with every asset"
  exit 0
fi
gh release edit "$v" --draft=false
[[ "$(gh release view "$v" --json isDraft --jq .isDraft)" == false ]] || { echo "publish-release: $v is still a draft" >&2; exit 1; }
echo "publish-release: $v published with ${#want[@]} assets; it is immutable from here"
