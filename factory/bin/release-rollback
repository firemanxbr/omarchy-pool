#!/usr/bin/env bash
# release-rollback <vX.Y.Z> — what .github/workflows/rollback.yml runs
# (#277): the pool goes back to an earlier release, the images and the
# Worker together, from anywhere, with no host touched.
#
#   gh workflow run rollback.yml -f to=v1.0.2
#
# 0. Before anything moves: that release's images passed both smoke starts
#    — its multi-arch `:v1.0.2` exists, which release.yml writes only once
#    both architectures started every role (a release whose smoke start
#    failed left `:<arch>-v1.0.2` pushed and no `:v1.0.2`, and is refused
#    here) — and its Worker is checked out, installed (`npm ci`) and built
#    (`wrangler deploy --dry-run`). A failure there moves nothing.
#    Then the rollback statement (#314, design v2 §5.3) is written and
#    signed, still before anything moves: a maintainer's host under the host
#    agent goes below its floor only on a statement rollback.yml signs on
#    main. `{schema: 1, seq, to, retracts_through, issued, agent_to: null,
#    run}`: `seq` one above the last statement stored (1 for the first);
#    `retracts_through` the release rolled back from — or the last
#    statement's, when that is higher, so a host that missed that rollback
#    is covered too (the agent takes `to < floor <= retracts_through`); the
#    highest release tag when the pool's release is not a release tag above
#    `to` (it cannot be read, or a re-run finds the pool already at `to`).
#    Both come from what the pool can write (its /version, R2), so each is
#    taken only when it is a release tag of this repository: a statement
#    never retracts past the highest one (the v* tag rulesets, #308). Signed by
#    `cosign sign-blob --bundle` (a Sigstore bundle v0.3, what
#    `omarchy-agent verify --statement` reads). No statement when no release
#    above `to` exists, and none with ROLLBACK_SIGN=0. The last statement is
#    read from R2 first: an answer other than "there is none yet", or one
#    that names no release tag, moves nothing.
# 1. The images: `:x86_64` and `:aarch64` re-pointed at that release's own
#    (`:<arch>-v1.0.2`, a copy), then `:latest` at its `:v1.0.2` — each new
#    digest signed, as a release signs its own. What each tag named before
#    is noted first.
# 2. The Worker of that release, deployed from its tag with
#    `POOL_VERSION=v1.0.2` and `POOL_DEPLOYED_AT` now: a pool left at the
#    newer release would refuse the older images as outdated (426). No
#    migration runs: they are forward-only and additive, and the database
#    keeps the newer ones. A deploy that fails puts the three tags back
#    where they were, so the fleet never follows images the pool refuses;
#    re-running the rollback is safe. Once that Worker is deployed, the
#    statement and its bundle go to R2 (omarchy-packages:
#    rollback/latest.json for the next `seq` first, then
#    rollback/<to>.sigstore.json and rollback/<to>.json), where
#    GET /api/v1/factory/rollback/<to> relays them; a store that fails
#    fails the run once the rest is done, and re-running stores a freshly
#    signed statement. A Worker from before #277 (a tag
#    without worker/src/orders.ts) spreads a worker's whole row in its
#    listing (GET /factory, GET /users/:login), so every column the Worker
#    from #277 keeps to itself — a worker's site, its process
#    (instance_finished copies instance), the rules' state, its rollout
#    report — is cleared just before that Worker is deployed and once more
#    right after: until it serves, the Worker from #277 writes them back at
#    every claim, and the older one never writes them. Kept: drained_at,
#    drained_by and drain_reason, a person's standing drain, which the Worker
#    from #277 serves as `drained` and needs back after a roll-forward; and
#    mode, history the Worker from #343 withholds, which an older one reads.
#    instance_churn goes to its default 0 (NOT NULL: a NULL would fail the
#    whole UPDATE). A task's stop_order goes too: the older Worker never
#    clears it, and a stale fence would refuse a later lease after the
#    roll-forward. The first claim after a roll-forward declares everything
#    again (docs/security-model: *A Worker rolled back past #277*, whose
#    UPDATE is CLEAR_277_SQL below).
# 3. A `deploy` event, "rolled back to v1.0.2 (from v1.0.3)", and the running
#    version checked — and, back past #277, the columns cleared once more,
#    for a claim an isolate of the newer Worker still served meanwhile.
#
# Then the fleet follows the brain: every updater from #277 on sees the
# pool's release change within two minutes (through /version when the
# Worker it went back to knows no follow) and replaces what runs the other
# image (the Studio's too, since its one-time step; an updater from before
# #277 at its own fifteen-minute round).
#
# Needs: IMAGE (ghcr.io/<owner>/omarchy-worker), OMARCHY_API (the pool's API,
# to read what runs), CLOUDFLARE_API_TOKEN (the deploy's, with Workers R2
# Storage: Edit for the statement), docker with buildx, git with the tags,
# node, jq; cosign to sign (ROLLBACK_SIGN=0 skips it, and the statement with it),
# the exact cosign rollback.yml installs, against the public-good Fulcio and
# Rekor named on the call as release.yml names them (#308).
# A `to` that is not a release tag of this repository is refused before
# anything moves.
set -euo pipefail
say() { printf '==> %s\n' "$*"; }
die() { printf 'release-rollback: %s\n' "$*" >&2; exit 2; }
to="${1:-}"
[[ "$to" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the release to go back to is a tag like v1.0.2 (got '${to}')"
git rev-parse -q --verify "refs/tags/$to^{commit}" >/dev/null || die "$to is not a tag of this repository: nothing moved"
: "${IMAGE:?IMAGE (ghcr.io/<owner>/omarchy-worker) is required}"
[[ -n "${CLOUDFLARE_API_TOKEN:-}" ]] || die "CLOUDFLARE_API_TOKEN is not set: the Worker has to go back with the images, so nothing moved"
: "${OMARCHY_API:=https://pkgs.omarchy-pool.org}"
from="$(curl -fsS --max-time 30 "$OMARCHY_API/api/v1/version" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
run_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-firemanxbr/omarchy-pool}/actions/runs/${GITHUB_RUN_ID:-0}"
say "rolling the pool back to $to (from ${from:-an unknown release})"
digest_of() { docker buildx imagetools inspect "$1" --format '{{json .Manifest.Digest}}' 2>/dev/null | tr -d '"'; }

# 0. What must hold before anything moves.
docker buildx imagetools inspect "$IMAGE:$to" >/dev/null 2>&1 \
  || die "$IMAGE:$to does not exist: $to's images never passed both architectures' smoke starts (or were never pushed) — go back to the release before it; nothing moved"
for arch in x86_64 aarch64; do
  docker buildx imagetools inspect "$IMAGE:$arch-$to" >/dev/null 2>&1 || die "$IMAGE:$arch-$to does not exist: that release's image was never pushed; nothing moved"
done
at="$(mktemp -d)"; work="$(mktemp -d)"
trap 'git worktree remove --force "$at" >/dev/null 2>&1 || rm -rf "$at"; rm -rf "$work"' EXIT
git worktree add --detach "$at" "$to" >/dev/null 2>&1 || die "could not check out $to: nothing moved"
commit="$(git rev-parse "$to^{commit}")"
(cd "$at/worker" && npm ci) || die "$to's Worker did not install (npm ci): nothing moved"
(cd "$at/worker" && npx wrangler deploy --dry-run --outdir "$at/dry-run" >/dev/null) || die "$to's Worker does not build (wrangler deploy --dry-run): nothing moved"
pre277=0; git cat-file -e "$to:worker/src/orders.ts" 2>/dev/null || pre277=1

# The rollback statement (#314): written and signed before anything moves, stored once the Worker of $to is deployed.
# The R2 keys GET /api/v1/factory/rollback/:to relays (worker/src/routes/rollback.ts; worker/test/rollback-relay.test.ts
# holds the two in step).
R2_BUCKET=omarchy-packages
statement_key="rollback/$to.json"; bundle_key="rollback/$to.sigstore.json"; last_key="rollback/latest.json"
release_re='^v[0-9]+\.[0-9]+\.[0-9]+$'
newest() { printf '%s\n' "$@" | { grep -E "$release_re" || true; } | sort -V | tail -n1; }  # the highest release named, or nothing
is_tag() { [[ "$1" =~ $release_re ]] && git rev-parse -q --verify "refs/tags/$1^{commit}" >/dev/null; }
statement=""
if [[ "${ROLLBACK_SIGN:-1}" == 1 ]]; then
  # The last statement stored, or none yet — wrangler's own words for a missing key; any other failure moves nothing.
  if ! (cd "$at/worker" && npx wrangler r2 object get "$R2_BUCKET/$last_key" --remote --pipe) >"$work/last.json" 2>"$work/last.err"; then
    grep -q "The specified key does not exist" "$work/last.err" || { cat "$work/last.err" >&2; die "could not read the last rollback statement ($R2_BUCKET/$last_key): nothing moved"; }
    : > "$work/last.json"
  fi
  last_seq=0; last_through=""
  if [[ -s "$work/last.json" ]]; then
    last_seq="$(jq -r '.seq' "$work/last.json" 2>/dev/null || true)"
    last_through="$(jq -r '.retracts_through' "$work/last.json" 2>/dev/null || true)"
    [[ "$last_seq" =~ ^[1-9][0-9]{0,15}$ ]] && is_tag "$last_through" \
      || die "the last rollback statement ($R2_BUCKET/$last_key) is not one, or names no release tag of this repository: nothing moved"
  fi
  # The pool's word (/version, latest.json) only ever picks a release tag: never past the highest one.
  through="$(newest $(git tag -l 'v*'))"
  if is_tag "$from" && [[ "$from" != "$to" && "$(newest "$from" "$to")" == "$from" ]]; then through="$from"; fi
  through="$(newest "$through" "$last_through")"
  if [[ -n "$through" && "$(newest "$through" "$to")" == "$through" && "$through" != "$to" ]]; then
    statement="$work/statement.json"
    jq -nc --argjson seq "$((last_seq + 1))" --arg to "$to" --arg through "$through" --arg issued "$(date -u +%FT%TZ)" --arg run "$run_url" \
      '{schema: 1, seq: $seq, to: $to, retracts_through: $through, issued: $issued, agent_to: null, run: $run}' > "$statement"
    cosign sign-blob --yes --fulcio-url=https://fulcio.sigstore.dev --rekor-url=https://rekor.sigstore.dev --new-bundle-format --bundle "$work/statement.sigstore.json" "$statement" \
      || die "the rollback statement was not signed: nothing moved"
    say "rollback statement $((last_seq + 1)) signed: back to $to, retracting everything through $through"
  else
    say "no release above $to to retract: no rollback statement"
  fi
else
  say "ROLLBACK_SIGN=0: no rollback statement"
fi
# The last one first (a failure after it only skips a seq, which hosts allow; never one seq relayed twice), then the bundle,
# then the statement: a host that reads between two puts verifies nothing new and asks again.
store_statement() {
  [[ -n "$statement" ]] || return 0
  (cd "$at/worker" \
    && npx wrangler r2 object put "$R2_BUCKET/$last_key" --remote --file "$statement" --content-type application/json \
    && npx wrangler r2 object put "$R2_BUCKET/$bundle_key" --remote --file "$work/statement.sigstore.json" --content-type application/json \
    && npx wrangler r2 object put "$R2_BUCKET/$statement_key" --remote --file "$statement" --content-type application/json) >/dev/null
}

# 1. The images: what each tag names now, then each architecture's tag, then :latest.
tags=(x86_64 aarch64 latest); before=()
for t in "${tags[@]}"; do before+=("$(digest_of "$IMAGE:$t" || true)"); done
restore() { # the three tags back where they were — each by the digest it named, a copy
  local i ok=1
  for i in "${!tags[@]}"; do
    [[ -n "${before[$i]}" ]] || continue
    docker buildx imagetools create --prefer-index=false -t "$IMAGE:${tags[$i]}" "$IMAGE@${before[$i]}" >/dev/null || ok=0
  done
  (( ok ))
}
# Fails when a step fails (never on the first, errexit is off inside an `if`): each step says so itself.
move_images() {
  local arch t
  for arch in x86_64 aarch64; do
    docker buildx imagetools create --prefer-index=false -t "$IMAGE:$arch" "$IMAGE:$arch-$to" || return 1
    say "$IMAGE:$arch → $arch-$to"
  done
  docker buildx imagetools create -t "$IMAGE:latest" "$IMAGE:$to" || return 1
  say "$IMAGE:latest → $to (both architectures)"
  if [[ "${ROLLBACK_SIGN:-1}" == 1 ]]; then
    for t in "${tags[@]}"; do cosign sign --yes --fulcio-url=https://fulcio.sigstore.dev --rekor-url=https://rekor.sigstore.dev "$IMAGE@$(digest_of "$IMAGE:$t")" || return 1; done
  fi
}
undo() { # why — the images back, and the rollback ends: nothing else moved
  if restore; then die "$1: the images are back where they were, and the pool still runs ${from:-its release}; nothing else moved — re-running rollback.yml -f to=$to is safe"
  else die "$1, and the images could not all be put back: re-run rollback.yml -f to=$to (safe), or re-run the latest release's worker-image-tags job (worker-image-manifest before #359)"; fi
}
move_images || undo "the images did not all move to $to"

# 2. The Worker of that release, from its tag; #277's columns cleared around the deploy when it is from before #277.
# Every column workerView withholds from #277 on, but drained_* and mode (worker/test/rollback-clear.test.ts keeps the two in step).
CLEAR_277_SQL="UPDATE build_workers SET instance = NULL, instance_prev = NULL, instance_since = NULL, instance_conflict_at = NULL, instance_other_at = NULL, instance_churn = 0, instance_finished = NULL, site = NULL, auto_orders = NULL, agent_error_since = NULL, agent_error_class = NULL, agent_probed_at = NULL, rollout = NULL, order_kinds = NULL, watchdog_exits = NULL WHERE instance IS NOT NULL OR instance_prev IS NOT NULL OR instance_since IS NOT NULL OR instance_conflict_at IS NOT NULL OR instance_other_at IS NOT NULL OR instance_churn != 0 OR instance_finished IS NOT NULL OR site IS NOT NULL OR auto_orders IS NOT NULL OR agent_error_since IS NOT NULL OR agent_error_class IS NOT NULL OR agent_probed_at IS NOT NULL OR rollout IS NOT NULL OR order_kinds IS NOT NULL OR watchdog_exits IS NOT NULL; UPDATE build_tasks SET stop_order = NULL WHERE stop_order IS NOT NULL;"
clear_277() {
  npx wrangler d1 execute omarchy-repo --remote --command "$CLEAR_277_SQL" >/dev/null
}
deployed_at="$(date -u +%FT%TZ)"
# (Inside the `if`, errexit is off: each step is chained. A first clear that fails is no reason to stop; the one after the deploy is.)
if ! (
  cd "$at/worker" && { (( pre277 == 0 )) || clear_277 || true; } \
    && npx wrangler deploy --var "POOL_VERSION:$to" --var "POOL_COMMIT:$commit" --var "POOL_DEPLOYED_AT:$deployed_at"
); then undo "the Worker of $to did not deploy"; fi
say "the Worker of $to is deployed ($commit)"
stored=1
if store_statement; then [[ -z "$statement" ]] || say "the rollback statement is in R2: GET /api/v1/factory/rollback/$to relays it"
else stored=0; echo "release-rollback: the rollback statement did not reach R2" >&2; fi
if (( pre277 )); then
  (cd "$at/worker" && clear_277) || die "the Worker of $to is deployed, but #277's columns were not cleared after it: run the UPDATE of docs/security-model (A Worker rolled back past #277) by hand"
  echo "==> $to is from before #277: what its listing would serve of #277's columns (site, the process, the rules' state, the rollout report) is cleared, before and after its deploy"
fi

# 3. On the record, and what runs now.
payload="$(jq -nc --arg v "$to" --arg from "${from:-}" --arg sha "$commit" --arg run "$run_url" \
  '{version: $v, rolled_back_from: $from, commit: $sha, bump: "rollback", run_url: $run}' | sed "s/'/''/g")"
(cd "$at/worker" && npx wrangler d1 execute omarchy-repo --remote --command \
  "INSERT INTO events (kind, status, summary, payload) VALUES ('deploy', 'ok', 'omarchy-pool rolled back to $to (from ${from:-unknown})', '$payload')" >/dev/null)
for _ in $(seq 1 12); do
  running="$(curl -fsS --max-time 30 "$OMARCHY_API/api/v1/version" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
  if [[ "$running" == "$to" ]]; then
    # Once more now that it serves: an isolate of the Worker from #277 may have answered a claim, and written them, since the last.
    if (( pre277 )); then
      (cd "$at/worker" && clear_277) || die "$to runs, but #277's columns were not cleared once it served: run the UPDATE of docs/security-model (A Worker rolled back past #277) by hand"
    fi
    (( stored )) || die "running $to, but its rollback statement did not reach R2: hosts under the host agent stay at their floor until one does — re-running rollback.yml -f to=$to is safe (it stores a freshly signed statement)"
    say "running $running: every updater follows it within two minutes"; exit 0
  fi
  sleep 5
done
die "expected $to running, got ${running:-nothing}"
