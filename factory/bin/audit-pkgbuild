#!/usr/bin/env python3
"""The second agent: audits a staged build's PKGBUILD, log and .PKGINFO.

Runs on a project worker whose owner set an agent key (ANTHROPIC_API_KEY,
OPENAI_API_KEY, GEMINI_API_KEY or XAI_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN — see agent.py; the key is
the worker owner's, never the pool's). Reads the evidence a contributor staged,
asks the model for a structured review following factory/prompts/audit.md
and writes audit.json and audit.md for the maintainer to read on the Review
page. Exit 0 with a report, non-zero when no report could be produced.

Usage: audit-pkgbuild --pkgbuild FILE --log FILE [--pkginfo FILE] --out DIR
"""
import argparse
import ast
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import agent  # noqa: E402

RULES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "prompts", "audit.md")


def parse(text):
    """The report in the answer, or None: bare JSON, JSON in a fence or in
    prose, and a Python-style dict (single quotes, True/None — what a model
    returns now and then; one audit died on it, 2026-09-15)."""
    text = re.sub(r"^```\w*\n|\n```\s*$", "", text.strip())
    m = re.search(r"\{.*\}", text, re.S)
    for candidate in (text, m.group(0) if m else None):
        if not candidate:
            continue
        try:
            return json.loads(candidate)
        except json.JSONDecodeError:
            pass
        try:
            value = ast.literal_eval(candidate)
            if isinstance(value, dict):
                return value
        except (ValueError, SyntaxError):
            pass
    return None


def ask(pkgbuild, log, pkginfo, tests=None):
    user = "--- PKGBUILD ---\n" + pkgbuild + "\n\n--- build log (tail) ---\n" + log[-12000:] + "\n"
    if pkginfo:
        user += "\n--- .PKGINFO ---\n" + pkginfo[:4000] + "\n"
    if tests:
        # The gate's transcript (tests.log): shellcheck, namcap on the PKGBUILD and the
        # package, the file list, the metadata, check(), the smoke test — what the
        # worker already found, so the audit weighs it instead of rediscovering it.
        user += "\n--- the gate (tests.log) ---\n" + tests[-6000:] + "\n"
    user += "\nReturn the JSON report only."
    # The budget covers the model's thinking too (Gemini counts it against
    # the output): 12 000 left a block verdict on brave-origin-bin cut
    # mid-finding, and a cut report is no report.
    rules = open(RULES).read() + agent.skills_text()
    text, model = agent.complete(rules, user, max_tokens=32000)
    report = parse(text)
    if report is None:
        # Once more, with the answer in front of it: the same report, as JSON.
        print("audit: the answer was not a JSON report; asking again", file=sys.stderr)
        again = user + "\n\nYour previous answer was not valid JSON:\n" + text[:3000] + "\n\nReturn the same report as strict JSON (double quotes, no comments, no prose), nothing else."
        text, model = agent.complete(rules, again, max_tokens=32000)
        report = parse(text)
    if report is None:
        sys.exit("the model did not return a JSON report:\n" + text[:500])
    if report.get("verdict") not in ("ok", "warn", "block"):
        sys.exit("the report has no verdict:\n" + text[:500])
    report["model"] = model
    report["findings"] = [f for f in report.get("findings", []) if isinstance(f, dict)]
    return report


def markdown(report):
    lines = [f"# Audit: {report['verdict']}", "", report.get("summary", ""), ""]
    if report["findings"]:
        lines.append("| Severity | Area | Where | What | Fix |")
        lines.append("|---|---|---|---|---|")
        for f in report["findings"]:
            cell = lambda k: str(f.get(k, "")).replace("|", "\\|").replace("\n", " ")
            lines.append(f"| {cell('severity')} | {cell('area')} | {cell('where')} | {cell('what')} | {cell('fix')} |")
    else:
        lines.append("No findings.")
    if report.get("category"):
        lines += ["", f"Category proposed: **{report['category']}** — a maintainer settles it."]
    lines += ["", f"_Reviewed by {report['model']} on a project worker; the maintainer decides._", ""]
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pkgbuild", required=True)
    ap.add_argument("--log", required=True)
    ap.add_argument("--pkginfo")
    ap.add_argument("--tests")
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    report = ask(open(a.pkgbuild).read(), open(a.log, errors="replace").read(),
                 open(a.pkginfo, errors="replace").read() if a.pkginfo else None,
                 open(a.tests, errors="replace").read() if a.tests else None)
    os.makedirs(a.out, exist_ok=True)
    with open(os.path.join(a.out, "audit.json"), "w") as f:
        json.dump(report, f, indent=1)
    with open(os.path.join(a.out, "audit.md"), "w") as f:
        f.write(markdown(report))
    print(f"{report['verdict']}: {report.get('summary', '')} ({len(report['findings'])} finding(s))")


if __name__ == "__main__":
    main()
