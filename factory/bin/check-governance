#!/usr/bin/env python3
"""Checks factory/MAINTAINERS.toml and keeps .github/CODEOWNERS derived from it.

The file lists the maintainers (see docs/GOVERNANCE.md) — one list, no
areas: every maintainer reviews everything. CODEOWNERS is what makes
GitHub ask a maintainer for review: the file itself, CODEOWNERS and the
sizing recipes are owned by every maintainer. (The project's own recipes
left the repository on 2026-09-17: packages are requested on the dashboard
and bumped by the pool, never through pull requests.) CI runs this without --write and fails when the two
disagree; a maintainer runs it with --write in the pull request that
changes the file.
"""
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
GOV = ROOT / "factory" / "MAINTAINERS.toml"
CODEOWNERS = ROOT / ".github" / "CODEOWNERS"
LOGIN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,38}$")


def load():
    doc = tomllib.loads(GOV.read_text())
    ms = doc.get("maintainers")
    if not isinstance(ms, list) or not ms or not all(isinstance(m, str) and LOGIN.match(m) for m in ms):
        sys.exit(f"{GOV.name}: `maintainers` must be a non-empty list of GitHub logins")
    if "groups" in doc:
        sys.exit(f"{GOV.name}: groups are gone — one `maintainers` list (docs/GOVERNANCE.md)")
    return sorted(dict.fromkeys(ms), key=str.lower)


def expected(maintainers):
    owners = " ".join("@" + m for m in maintainers)
    lines = [
        "# Generated from factory/MAINTAINERS.toml by factory/bin/check-governance --write;",
        "# CI fails when the two disagree. Every maintainer owns the governance file,",
        "# this one and the sizing recipes. With main requiring a code-owner review,",
        "# a change here is a decision another maintainer approves.",
        f"factory/MAINTAINERS.toml  {owners}",
        f".github/CODEOWNERS        {owners}",
        f"factory/sizing/           {owners}",
    ]
    return "\n".join(lines) + "\n"


def main():
    maintainers = load()
    want = expected(maintainers)
    have = CODEOWNERS.read_text() if CODEOWNERS.exists() else ""
    if "--write" in sys.argv:
        CODEOWNERS.write_text(want)
        print(f"{CODEOWNERS.relative_to(ROOT)} written for {len(maintainers)} maintainer(s)")
        return
    if have != want:
        sys.exit(f"{CODEOWNERS.relative_to(ROOT)} does not match {GOV.relative_to(ROOT)}; run factory/bin/check-governance --write")
    print(f"governance ok: {len(maintainers)} maintainer(s): {', '.join(maintainers)}")


if __name__ == "__main__":
    main()
