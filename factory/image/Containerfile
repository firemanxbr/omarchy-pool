# omarchy-worker — the one image every worker runs, contributor or maintainer.
#
# What it does is decided by the registration behind the token it is given
# (entrypoint.sh): a contributor's worker builds their packages right here,
# one task per container, into their staging workspace; a project worker —
# a registration a maintainer trusted — runs `pkg-repo work`: the pool's
# jobs and the rebuild of approved packages, each in a fresh sibling
# container through the runtime's socket the operator mounts.
#
# The image carries no key and no pool credential: the pool signs, and a
# worker's token only claims; each task runs with the per-job token the
# claim issues. Whoever runs it brings the token and, for an agent that
# drafts and corrects PKGBUILDs, their own agent key (Anthropic, OpenAI, Gemini or xAI).
#
# Arch Linux, both architectures, built by the release workflow from the
# binaries it just published (the tag is the pool's release) and signed
# keyless with cosign (GitHub OIDC):
#   cosign verify ghcr.io/firemanxbr/omarchy-worker:latest \
#     --certificate-identity-regexp 'github.com/firemanxbr/omarchy-pool' \
#     --certificate-oidc-issuer https://token.actions.githubusercontent.com
ARG BASE=docker.io/library/archlinux:base-devel
FROM ${BASE}
ARG ARCH=x86_64
ARG POOL_RELEASE
ARG DOCKER_CLI=27.5.1
LABEL org.opencontainers.image.source="https://github.com/firemanxbr/omarchy-pool" \
      org.opencontainers.image.description="Omarchy Worker: builds for the Omarchy pool — a contributor's packages, or the project's jobs and approved rebuilds" \
      org.opencontainers.image.licenses="MIT"
# pacman's download sandbox needs privileges a container build does not have.
RUN sed -i '0,/^\[options\]/s//[options]\nDisableSandboxSyscalls\nDisableSandboxFilesystem/' /etc/pacman.conf \
 && pacman -Syu --noconfirm --needed git curl jq python libarchive gnupg bash ca-certificates sudo namcap pacman-contrib && pacman -Scc --noconfirm
# shellcheck for the gate, in the image: Arch ships it, Arch Linux ARM does not — a build must never download it (the gate warns without it, but never waits on GitHub).
RUN set -eu; if pacman -S --noconfirm --needed shellcheck >/dev/null 2>&1; then pacman -Scc --noconfirm; else \
      v=v0.11.0; case "${ARCH}" in x86_64) sum=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198 ;; aarch64) sum=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588 ;; esac; \
      curl -fsSL -o /tmp/sc.tar.xz "https://github.com/koalaman/shellcheck/releases/download/$v/shellcheck-$v.linux.${ARCH}.tar.xz"; \
      echo "$sum  /tmp/sc.tar.xz" | sha256sum -c -; tar -xJf /tmp/sc.tar.xz -C /tmp; install -m755 "/tmp/shellcheck-$v/shellcheck" /usr/local/bin/shellcheck; rm -rf /tmp/sc.tar.xz "/tmp/shellcheck-$v"; fi
# The docker CLI, static: it talks to whatever Docker-compatible socket is mounted at /var/run/docker.sock (project mode).
RUN curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-${DOCKER_CLI}.tgz" | tar -xz --strip-components=1 -C /usr/local/bin docker/docker
# The compose plugin, pinned by checksum: the updater role (factory/bin/omarchy-rollout) recreates a compose
# project's services from the new image through the same socket — every worker follows the latest image.
ARG COMPOSE=v5.5.1
RUN set -eu; case "$ARCH" in x86_64) sum=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576 ;; aarch64) sum=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7 ;; esac; \
    curl -fsSL -o /tmp/docker-compose "https://github.com/docker/compose/releases/download/${COMPOSE}/docker-compose-linux-${ARCH}"; \
    echo "$sum  /tmp/docker-compose" | sha256sum -c -; install -Dm755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose; rm -f /tmp/docker-compose
# The pool's tools, from the release this image is tagged with (project mode).
RUN set -eu; name="omarchy-pool-${POOL_RELEASE}-${ARCH}-linux"; \
    curl -fsSL -o /tmp/tools.tgz "https://github.com/firemanxbr/omarchy-pool/releases/download/${POOL_RELEASE}/${name}.tar.gz"; \
    curl -fsSL -o /tmp/tools.tgz.sha256 "https://github.com/firemanxbr/omarchy-pool/releases/download/${POOL_RELEASE}/${name}.tar.gz.sha256"; \
    cd /tmp && echo "$(cut -d' ' -f1 tools.tgz.sha256)  tools.tgz" | sha256sum -c -; \
    tar -xzf /tmp/tools.tgz -C /tmp && install -m 755 "/tmp/${name}"/pkg-repo "/tmp/${name}"/omarchy-cli "/tmp/${name}"/pkg-extract /usr/local/bin/ && rm -rf /tmp/tools.tgz* "/tmp/${name}"
# The build half and the drafter (community mode), the auditor (project mode
# with an agent key); pacman runs at first start of a build.
COPY factory/worker/omarchy-build-worker.sh /usr/local/bin/omarchy-build-worker
COPY factory/image/entrypoint.sh /usr/local/bin/omarchy-worker
COPY factory/bin/draft-pkgbuild factory/bin/pkgbuild-meta factory/bin/audit-pkgbuild factory/bin/agent.py factory/bin/broker factory/bin/omarchy-rollout /usr/local/lib/omarchy-factory/bin/
COPY factory/prompts/pkgbuild.md factory/prompts/audit.md /usr/local/lib/omarchy-factory/prompts/
COPY factory/skills /usr/local/lib/omarchy-factory/skills/
# The pool's public key: a build verifies the pool's databases against it without cloning anything.
COPY docs/omarchy-staging.pub.asc /usr/local/lib/omarchy-factory/omarchy-staging.pub.asc
RUN chmod 755 /usr/local/bin/omarchy-build-worker /usr/local/bin/omarchy-worker /usr/local/lib/omarchy-factory/bin/* && mkdir -p /build /task /var/lib/omarchy-worker
# OMARCHY_IMAGE: the release this image is, reported with every claim (the Workers page shows it).
ENV OMARCHY_API=https://pkgs.firemanxbr.org OMARCHY_POOL=https://pool.firemanxbr.org \
    OMARCHY_WORK_DIR=/var/lib/omarchy-worker DOCKER_HOST=unix:///var/run/docker.sock OMARCHY_IMAGE=${POOL_RELEASE}
VOLUME /var/lib/omarchy-worker
WORKDIR /build
ENTRYPOINT ["omarchy-worker"]
