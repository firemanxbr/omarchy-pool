# omarchy-worker — the one image a maintainer host runs, in every container it starts.
#
# What a container of it does is its role (entrypoint.sh): on a maintainer host the
# `dispatcher` (the host set's one service, `pkg-repo dispatch`), a task's `egress` sidecar
# and its `agent` sidecar (factory/bin/broker, the agent and GitHub read-only for one task);
# the task containers themselves start from the build image by digest, never from this one.
#
# The image carries no key and no pool credential: the pool signs, the host's worker token
# only claims and lives in a read-only file the host set mounts into the dispatcher, and
# each task runs with the per-job token its claim issues. The host's owner brings the agent
# keys, in a file only the agent sidecars mount.
#
# Arch Linux, both architectures, built by the release workflow from the
# binaries it just published (the tag is the pool's release) and signed
# keyless with cosign (GitHub OIDC) by release.yml on main, and nothing else:
#   cosign verify ghcr.io/firemanxbr/omarchy-worker:latest \
#     --certificate-identity https://github.com/firemanxbr/omarchy-pool/.github/workflows/release.yml@refs/heads/main \
#     --certificate-oidc-issuer https://token.actions.githubusercontent.com
# (after a rollback the tags are signed by rollback.yml@refs/heads/main: the same command with that file).
# The base image by digest (#308): the tag is kept for the reader, the digest is what pulls. release.yml passes
# each architecture's, pinned the same way.
ARG BASE=docker.io/library/archlinux:base-devel@sha256:51dd3d24f7fba779e7c471caeee7804c50e8c134ad948e19685a1c83a42facc3
FROM ${BASE}
ARG ARCH=x86_64
ARG POOL_RELEASE
# Where the release's binaries are fetched from: the GitHub release by default; CI's smoke start of a local build serves this
# commit's own from the runner (tests/image-smoke.sh, the ci.yml job that builds the image).
ARG TOOLS_URL=https://github.com/firemanxbr/omarchy-pool/releases/download/${POOL_RELEASE}
# Below 29 while podman 4 hosts are served (#372): podman 4's docker API shows a task network the dispatcher makes through
# libpod (no gateway) with "Gateway": "<nil>", which docker's CLI from 29 on fails to parse (`network ls`, `network
# inspect`: ParseAddr("<nil>")), and the dispatcher lists its networks with it. A bump needs a podman that omits that
# gateway, or the dispatcher listing networks another way; tests/host-bundle.py holds the pin below 29 until then.
ARG DOCKER_CLI=27.5.1
LABEL org.opencontainers.image.source="https://github.com/firemanxbr/omarchy-pool" \
      org.opencontainers.image.description="Omarchy Worker: a maintainer host's dispatcher and its tasks' sidecars, for the Omarchy pool" \
      org.opencontainers.image.licenses="MIT"
# pacman's download sandbox needs privileges a container build does not have.
RUN sed -i '0,/^\[options\]/s//[options]\nDisableSandboxSyscalls\nDisableSandboxFilesystem/' /etc/pacman.conf \
 && pacman -Syu --noconfirm --needed git curl jq python libarchive gnupg bash ca-certificates sudo namcap pacman-contrib && pacman -Scc --noconfirm
# shellcheck for the gate, in the image: Arch ships it, Arch Linux ARM does not — a build must never download it (the gate warns without it, but never waits on GitHub).
RUN set -eu; if pacman -S --noconfirm --needed shellcheck >/dev/null 2>&1; then pacman -Scc --noconfirm; else \
      v=v0.11.0; case "${ARCH}" in x86_64) sum=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198 ;; aarch64) sum=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588 ;; esac; \
      curl -fsSL -o /tmp/sc.tar.xz "https://github.com/koalaman/shellcheck/releases/download/$v/shellcheck-$v.linux.${ARCH}.tar.xz"; \
      echo "$sum  /tmp/sc.tar.xz" | sha256sum -c -; tar -xJf /tmp/sc.tar.xz -C /tmp; install -m755 "/tmp/shellcheck-$v/shellcheck" /usr/local/bin/shellcheck; rm -rf /tmp/sc.tar.xz "/tmp/shellcheck-$v"; fi
# The docker CLI, static, pinned by checksum (#308): the dispatcher starts every task container and sidecar through
# whatever Docker-compatible socket the host set mounts at /var/run/docker.sock. A new DOCKER_CLI needs both sums again.
RUN set -eu; case "$ARCH" in x86_64) sum=4f798b3ee1e0140eab5bf30b0edc4e84f4cdb53255a429dc3bbae9524845d640 ;; aarch64) sum=e6b53725a73763ab3f988c73f8772eaed429754c1a579db5ff11f21990fd1817 ;; esac; \
    curl -fsSL -o /tmp/docker.tgz "https://download.docker.com/linux/static/stable/${ARCH}/docker-${DOCKER_CLI}.tgz"; \
    echo "$sum  /tmp/docker.tgz" | sha256sum -c -; tar -xzf /tmp/docker.tgz --strip-components=1 -C /usr/local/bin docker/docker; rm -f /tmp/docker.tgz
# The compose plugin, pinned by checksum: the version and sums the host bundle pins for the agent's own compose
# (factory/bundle/manifest.toml; tests/host-bundle.py holds the two equal), so one compose is in use wherever the
# release runs one. A new COMPOSE needs both sums again, here and in the manifest.
ARG COMPOSE=v5.5.1
RUN set -eu; case "$ARCH" in x86_64) sum=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576 ;; aarch64) sum=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7 ;; esac; \
    curl -fsSL -o /tmp/docker-compose "https://github.com/docker/compose/releases/download/${COMPOSE}/docker-compose-linux-${ARCH}"; \
    echo "$sum  /tmp/docker-compose" | sha256sum -c -; install -Dm755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose; rm -f /tmp/docker-compose
# The pool's tools, from the release this image is tagged with: pkg-repo is the dispatcher and the egress sidecar.
RUN set -eu; name="omarchy-pool-${POOL_RELEASE}-${ARCH}-linux"; \
    curl -fsSL -o /tmp/tools.tgz "${TOOLS_URL}/${name}.tar.gz"; \
    curl -fsSL -o /tmp/tools.tgz.sha256 "${TOOLS_URL}/${name}.tar.gz.sha256"; \
    cd /tmp && echo "$(cut -d' ' -f1 tools.tgz.sha256)  tools.tgz" | sha256sum -c -; \
    tar -xzf /tmp/tools.tgz -C /tmp && install -m 755 "/tmp/${name}"/pkg-repo "/tmp/${name}"/omarchy-cli "/tmp/${name}"/pkg-extract /usr/local/bin/ && rm -rf /tmp/tools.tgz* "/tmp/${name}"
# The build half and the drafter, the auditor (with an agent key); pacman runs at first start of a build.
COPY factory/worker/omarchy-build-worker.sh /usr/local/bin/omarchy-build-worker
COPY factory/image/entrypoint.sh /usr/local/bin/omarchy-worker
COPY factory/bin/draft-pkgbuild factory/bin/pkgbuild-meta factory/bin/audit-pkgbuild factory/bin/agent.py factory/bin/broker /usr/local/lib/omarchy-factory/bin/
COPY factory/prompts/pkgbuild.md factory/prompts/audit.md /usr/local/lib/omarchy-factory/prompts/
COPY factory/skills /usr/local/lib/omarchy-factory/skills/
# The pool's public key: a build verifies the pool's databases against it without cloning anything.
COPY docs/omarchy-staging.pub.asc /usr/local/lib/omarchy-factory/omarchy-staging.pub.asc
RUN chmod 755 /usr/local/bin/omarchy-build-worker /usr/local/bin/omarchy-worker /usr/local/lib/omarchy-factory/bin/* && mkdir -p /build /task /var/lib/omarchy-worker
# OMARCHY_IMAGE: the release this image is, reported with every claim (the Workers page shows it).
ENV OMARCHY_API=https://pkgs.omarchy-pool.org OMARCHY_POOL=https://pool.omarchy-pool.org \
    OMARCHY_WORK_DIR=/var/lib/omarchy-worker DOCKER_HOST=unix:///var/run/docker.sock OMARCHY_IMAGE=${POOL_RELEASE}
VOLUME /var/lib/omarchy-worker
WORKDIR /build
ENTRYPOINT ["omarchy-worker"]
